{
    "name": "ichava/tabler-icons",
    "description": "5,900+ Tabler SVG icons for Laravel. Outline + filled variants, customisable stroke widths, MIT-licensed. Built on the Ichava ecosystem.",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "icons",
        "svg",
        "tabler",
        "tabler-icons",
        "ichava"
    ],
    "homepage": "https://github.com/ichava/tabler-icons",
    "license": "MIT",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "ichava/core": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\TablerIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\TablerIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Ichava\\TablerIcons\\Providers\\IconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/ichava/tabler-icons",
        "issues": "https://github.com/ichava/tabler-icons/issues",
        "security": "https://github.com/ichava/tabler-icons/security/policy"
    }
}
